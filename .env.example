PORT=3000
# demo accepts placeholder headers and does not interact with a facilitator.
# Set to x402 only after configuring the testnet recipient address below.
PAYMENT_MODE=demo
PAY_TO_ADDRESS=
PAYMENT_PRICE_USDC=$0.10
FACILITATOR_URL=https://x402.org/facilitator
# The installed SDK default is 90 seconds; cap this at the route's 120-second limit.
FACILITATOR_TIMEOUT_MS=90000

# Exact hostnames only, comma-separated. Vendor URLs must resolve exclusively
# to public IPv4 addresses; IPv6 destinations are intentionally not supported.
VENDOR_ALLOWLIST=
REQUEST_TIMEOUT_MS=10000
MAX_BODY_BYTES=65536
MAX_VENDOR_RESPONSE_BYTES=1048576
TRUST_PROXY=0
